{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Data Studio",
  "mainBinaryName": "data-studio",
  "version": "1.2.1",
  "identifier": "com.studiofamily.datastudio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Data Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https: http:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "CSV, JSON and Excel viewer",
    "longDescription": "View, filter, sort, chart, edit and convert CSV, JSON and Excel files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["csv", "tsv"],
        "name": "CSV data",
        "description": "Comma or tab separated data",
        "role": "Editor",
        "mimeType": "text/csv"
      },
      {
        "ext": ["jsonl", "ndjson"],
        "name": "JSON Lines data",
        "description": "JSON Lines data",
        "role": "Viewer",
        "mimeType": "application/x-ndjson"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
